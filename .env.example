# OpenHIM core registration (skip entirely with MEDIATOR_STANDALONE=true)
OPENHIM_USERNAME=root@openhim.org
OPENHIM_PASSWORD=
OPENHIM_API_URL=https://localhost:8081
OPENHIM_TRUST_SELF_SIGNED=true

# Host-side ports for OpenHIM's admin API/router/console, published via
# docker-compose.yml. Only relevant to the Docker Compose flow -- optional
# overrides, defaults match this project's current/historical values. Change
# any of these if it collides with another app already using that port on a
# shared host. NOT auto-derived from anything: if you override one of these,
# also update OPENHIM_API_URL/OPENHIM_ROUTER_URL/ADVAPACS_CHANNEL_URL below to
# match, since those are the host-facing forms a human (or a non-Docker
# `npm start`) actually connects through.
OPENHIM_ADMIN_API_HOST_PORT=8081
OPENHIM_ROUTER_HTTPS_HOST_PORT=5000
OPENHIM_ROUTER_HTTP_HOST_PORT=5001
OPENHIM_CONSOLE_HOST_PORT=9000

# Mediator server
MEDIATOR_PORT=3500
MEDIATOR_STANDALONE=false
LOG_LEVEL=info

# How OpenMRS ServiceRequests reach us: 'push' mounts POST /fhir/ServiceRequest
# for OpenMRS (or an event listener module) to call; 'poll' instead pulls from
# OpenMRS's FHIR ServiceRequest search on an interval. See src/lib/orderPoller.js.
ORDER_INGESTION_MODE=poll
ORDER_POLL_INTERVAL_MS=15000

# OpenHIM's router (channel-serving port, distinct from OPENHIM_API_URL's admin
# API). orderPoller.js POSTs each polled ServiceRequest here instead of calling
# orderRelay.js in-process, so the hop is visible/retryable as an OpenHIM
# transaction. In docker-compose this is overridden to http://openhim-core:5001.
OPENHIM_ROUTER_URL=http://localhost:5001

# Credentials orderPoller.js authenticates with (HTTP Basic auth) against the
# inbound "OpenMRS to Mediator Order Push" OpenHIM channel, now authType:
# "private". scripts/setupOpenhim.js registers a matching OpenHIM Client (role
# "openmrs") from these values on every run. In push mode, OpenMRS's own
# event-listener module must send the same credentials.
OPENHIM_INBOUND_CLIENT_ID=openmrs
OPENHIM_INBOUND_CLIENT_PASSWORD=

# Shared secret required as the `X-Mediator-Secret` header on every POST to
# this mediator's /fhir/ServiceRequest -- an app-level backstop independent of
# OpenHIM channel auth (protects direct access too, e.g. the non-Docker run
# modes). Both orderPoller.js and (in push mode) OpenMRS's own module must
# send this. Generate with `openssl rand -hex 32`.
MEDIATOR_INBOUND_SECRET=

# OpenMRS FHIR2 module. In docker-compose, this is read from .env as-is (see
# docker-compose.yml) -- if OpenMRS runs on this same host, use
# http://host.docker.internal:8080/openmrs, not localhost (which inside the
# mediator's container means the container itself, not the host machine).
OPENMRS_BASE_URL=https://example.org/openmrs
OPENMRS_FHIR_PATH=/ws/fhir2/R4
OPENMRS_USERNAME=
OPENMRS_PASSWORD=

# FHIR identifier system used to reference the patient on outbound
# ServiceRequests (orderRelay.js), instead of an OpenMRS-internal UUID.
# Site-specific -- a different PIH site would use a different system URI.
PATIENT_IDENTIFIER_SYSTEM=http://www.pih.org/identifiers/lesotho/emr-id

# AdvaPACS FHIR API. ADVAPACS_BASE_URL is the *real* AdvaPACS host -- only
# read by scripts/setupOpenhim.js to configure the outbound channel's route
# target, never called directly by the running app anymore. advapacsClient.js
# instead calls ADVAPACS_CHANNEL_URL, OpenHIM's outbound channel, which proxies
# on to ADVAPACS_BASE_URL (see mediatorConfig.json's "Mediator to AdvaPACS
# order push" channel). In docker-compose ADVAPACS_CHANNEL_URL is overridden
# to http://openhim-core:5001/advapacs.
ADVAPACS_BASE_URL=https://usa1.api.integration.advapacs.com/fhir/R5
ADVAPACS_CHANNEL_URL=http://localhost:5001/advapacs
ADVAPACS_CLIENT_ID=
ADVAPACS_CLIENT_SECRET=

# Shared secret AdvaPACS must send back as `Authorization: Bearer <secret>`
# on its Subscription rest-hook calls to this mediator's /webhooks/advapacs.
ADVAPACS_WEBHOOK_SECRET=
