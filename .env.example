# OpenHIM core registration (skip entirely with MEDIATOR_STANDALONE=true)
OPENHIM_USERNAME=root@openhim.org
OPENHIM_PASSWORD=
OPENHIM_API_URL=https://localhost:8080
OPENHIM_TRUST_SELF_SIGNED=true

# Mediator server
MEDIATOR_PORT=3500
MEDIATOR_STANDALONE=false
LOG_LEVEL=info

# How OpenMRS ServiceRequests reach us: 'push' mounts POST /fhir/ServiceRequest
# for OpenMRS (or an event listener module) to call; 'poll' instead pulls from
# OpenMRS's FHIR ServiceRequest search on an interval. See src/lib/orderPoller.js.
ORDER_INGESTION_MODE=push
ORDER_POLL_INTERVAL_MS=60000

# OpenHIM's router (channel-serving port, distinct from OPENHIM_API_URL's admin
# API). orderPoller.js POSTs each polled ServiceRequest here instead of calling
# orderRelay.js in-process, so the hop is visible/retryable as an OpenHIM
# transaction. In docker-compose this is overridden to http://openhim-core:5001.
OPENHIM_ROUTER_URL=http://localhost:5001

# OpenMRS FHIR2 module
OPENMRS_BASE_URL=https://example.org/openmrs
OPENMRS_FHIR_PATH=/ws/fhir2/R4
OPENMRS_USERNAME=
OPENMRS_PASSWORD=

# FHIR identifier system used to reference the patient on outbound
# ServiceRequests (orderRelay.js), instead of an OpenMRS-internal UUID.
# Site-specific -- a different PIH site would use a different system URI.
PATIENT_IDENTIFIER_SYSTEM=http://www.pih.org/identifiers/lesotho/emr-id

# AdvaPACS FHIR API. ADVAPACS_BASE_URL is the *real* AdvaPACS host -- only
# read by scripts/setupOpenhim.js to configure the outbound channel's route
# target, never called directly by the running app anymore. advapacsClient.js
# instead calls ADVAPACS_CHANNEL_URL, OpenHIM's outbound channel, which proxies
# on to ADVAPACS_BASE_URL (see mediatorConfig.json's "Mediator to AdvaPACS
# order push" channel). In docker-compose ADVAPACS_CHANNEL_URL is overridden
# to http://openhim-core:5001/advapacs.
ADVAPACS_BASE_URL=https://example.api.integration.advapacs.com/fhir
ADVAPACS_CHANNEL_URL=http://localhost:5001/advapacs
ADVAPACS_CLIENT_ID=
ADVAPACS_CLIENT_SECRET=

# Shared secret AdvaPACS must send back as `Authorization: Bearer <secret>`
# on its Subscription rest-hook calls to this mediator's /webhooks/advapacs.
ADVAPACS_WEBHOOK_SECRET=
